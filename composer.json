{
    "name": "tokalink/inermin",
    "description": "Inertia.js Admin Panel & CRUD Generator for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tokalink",
            "email": "info@tokalink.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "inertiajs/inertia-laravel": "^1.0|^2.0",
        "rap2hpoutre/fast-excel": "^5.0",
        "barryvdh/laravel-dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Tokalink\\Inermin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tokalink\\Inermin\\InerminServiceProvider"
            ],
            "aliases": {
                "Inermin": "Tokalink\\Inermin\\facades\\Inermin"
            }
        }
    }
}
